# ---- LLM provider ----
# anthropic | openai | mock   (mock = deterministic grounded answers, no API key needed)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ---- Embeddings ----
# local | openai | voyage   (local = hashed char n-gram embeddings, works offline, good enough for MVP)
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=

# ---- Storage ----
DATABASE_PATH=./data/agent.db
UPLOAD_DIR=./data/uploads

# ---- Dashboard admin auth ----
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Public URL used in widget snippets ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
